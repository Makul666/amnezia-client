```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/
*.o
*.obj
*.so
*.dll
*.exe

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Coverage
.coverage
coverage/
htmlcov/

# OS specific
.DS_Store
Thumbs.db
```